# Minecraft server
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=Claude
# "offline" for cracked/LAN servers, "microsoft" for online-mode servers
MC_AUTH=offline
# Leave blank to auto-detect
MC_VERSION=

# One OpenRouter key (https://openrouter.ai/keys) runs both the brain and Jev.
OPENROUTER_API_KEY=

# Brain: any OpenRouter model that supports tool calling
BRAIN_MODEL=deepseek/deepseek-v4.1-flash
# Reasoning effort: low, medium or high
BRAIN_EFFORT=medium
# Start a fresh brain instance when the conversation passes this many tokens
BRAIN_CONTEXT_LIMIT=150000
# Minimum seconds between routine planner check-ins (events like chat or damage wake it sooner)
BRAIN_HEARTBEAT_SECONDS=45

# Decision layer (Jev). Uses the OpenRouter key above.
JEV_MODEL=~typesafe/jev-latest
# Milliseconds between reflex decisions
REFLEX_INTERVAL_MS=1000
# Set JEV_DISABLED=1 to use the built-in utility scorer instead of Jev

# Where memories are written. One folder per bot username.
MEMORY_DIR=./data
# Players the bot should treat as trusted from the start (comma-separated)
TRUSTED_PLAYERS=
